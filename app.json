{
  "expo": {
    "name": "AttendPay",
    "slug": "automated-attendance-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/uict-logo.png",
    "scheme": "attendpay",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.attendpay.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/uict-logo.png",
        "backgroundColor": "#0060B8"
      },
      "package": "com.attendpay.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/uict-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/uict-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0060B8",
          "dark": {
            "backgroundColor": "#0A2540"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow AttendPay to access your camera to scan QR codes."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow AttendPay to access your location to record attendance.",
          "locationWhenInUsePermission": "Allow AttendPay to access your location to record attendance."
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "a7889c38-7238-42b1-a0f1-86a55355fdf3"
      }
    },
    "owner": "abraham123"
  }
}
